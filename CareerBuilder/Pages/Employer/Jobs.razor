@page "/employer/jobs"
@using CareerBuilder.Models
@using CareerBuilder.Services
@using CareerBuilder.Services.Interface
@inject IJobService JobService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Employer")]

<PageTitle>My Jobs - CareerBuilder</PageTitle>

<div class="bg-white">
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page header -->
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    My Jobs
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Manage your job postings and applications
                </p>
            </div>
            <div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
                <button @onclick="NavigateBack"
                        class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                    Back to Dashboard
                </button>
                <button @onclick="NavigateToCreateJob"
                        class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    Post New Job
                </button>
            </div>
        </div>

        <!-- Stats Overview -->
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-4 mb-8">
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6" />
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Total Jobs</dt>
                                <dd class="text-lg font-medium text-gray-900">@myJobs.Count</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-green-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Active Jobs</dt>
                                <dd class="text-lg font-medium text-gray-900">@myJobs.Count(j => j.IsActive)</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-purple-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Total Applications</dt>
                                <dd class="text-lg font-medium text-gray-900">@myJobs.Sum(j => j.ApplicationCount)</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-yellow-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Avg Applications</dt>
                                <dd class="text-lg font-medium text-gray-900">@(myJobs.Any() ? (myJobs.Sum(j => j.ApplicationCount) / (double)myJobs.Count).ToString("F1") : "0")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-8">
                <div class="inline-flex items-center">
                    <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Loading jobs...
                </div>
            </div>
        }
        else if (myJobs.Any())
        {
            <!-- Jobs List -->
            <div class="bg-white shadow overflow-hidden sm:rounded-md">
                <ul class="divide-y divide-gray-200">
                    @foreach (var job in myJobs)
                    {
                        <li>
                            <div class="px-4 py-4 sm:px-6">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center flex-1">
                                        <div class="flex-shrink-0 h-12 w-12">
                                            <div class="h-12 w-12 rounded-full bg-indigo-500 flex items-center justify-center">
                                                <span class="text-lg font-medium text-white">
                                                    @job.Title.Substring(0, 1).ToUpper()
                                                </span>
                                            </div>
                                        </div>
                                        <div class="ml-4 flex-1">
                                            <div class="flex items-center justify-between">
                                                <div>
                                                    <div class="flex items-center">
                                                        <p class="text-sm font-medium text-indigo-600 truncate">
                                                            @job.Title
                                                        </p>
                                                        <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetJobStatusBadgeClass(job.IsActive)">
                                                            @(job.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                        <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetJobTypeBadgeClass(job.JobType)">
                                                            @job.JobType
                                                        </span>
                                                    </div>
                                                    <p class="text-sm text-gray-500">@job.Location</p>
                                                    <p class="text-sm text-gray-900 mt-1">@job.SalaryRange</p>
                                                    <div class="mt-2 flex items-center text-sm text-gray-500">
                                                        <span>Posted @job.PostedDate.ToString("MMM dd, yyyy")</span>
                                                        @if (job.ExpiryDate.HasValue)
                                                        {
                                                            <span class="ml-4">Expires @job.ExpiryDate.Value.ToString("MMM dd, yyyy")</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="text-right">
                                                    <div class="flex items-center space-x-4">
                                                        <!-- Applications Count -->
                                                        <div class="text-center">
                                                            <p class="text-2xl font-bold text-gray-900">@job.ApplicationCount</p>
                                                            <p class="text-xs text-gray-500">Applications</p>
                                                        </div>
                                                        
                                                        <!-- Action Buttons -->
                                                        <div class="flex flex-col space-y-2">
                                                            <button @onclick="() => ViewApplications(job.Id)"
                                                                    class="inline-flex items-center px-3 py-1 border border-gray-300 shadow-sm text-xs leading-4 font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                                <svg class="mr-1 h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                                                </svg>
                                                                View Applications
                                                            </button>
                                                            <button @onclick="() => EditJob(job.Id)"
                                                                    class="inline-flex items-center px-3 py-1 border border-gray-300 shadow-sm text-xs leading-4 font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                                <svg class="mr-1 h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                                </svg>
                                                                Edit Job
                                                            </button>
                                                            <button @onclick="() => ToggleJobStatus(job)"
                                                                    class="inline-flex items-center px-3 py-1 border border-gray-300 shadow-sm text-xs leading-4 font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                                @(job.IsActive ? "Deactivate" : "Activate")
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Job Description Preview -->
                                @if (expandedJobId == job.Id)
                                {
                                    <div class="mt-4 border-t border-gray-200 pt-4">
                                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                            <div>
                                                <h4 class="text-sm font-medium text-gray-900">Description</h4>
                                                <p class="mt-1 text-sm text-gray-600">@job.Description</p>
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-medium text-gray-900">Requirements</h4>
                                                <p class="mt-1 text-sm text-gray-600">@job.Requirements</p>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(job.Benefits))
                                        {
                                            <div class="mt-4">
                                                <h4 class="text-sm font-medium text-gray-900">Benefits</h4>
                                                <p class="mt-1 text-sm text-gray-600">@job.Benefits</p>
                                            </div>
                                        }
                                        <div class="mt-4 flex justify-end">
                                            <button @onclick="() => CollapseJob()"
                                                    class="text-sm text-indigo-600 hover:text-indigo-500">
                                                Hide Details
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-4 border-t border-gray-200 pt-4">
                                        <button @onclick="() => ExpandJob(job.Id)"
                                                class="text-sm text-indigo-600 hover:text-indigo-500">
                                            Show Details ↓
                                        </button>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No jobs posted yet</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by posting your first job.</p>
                <div class="mt-6">
                    <button @onclick="NavigateToCreateJob"
                            class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Post Your First Job
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Job> myJobs = new();
    private bool isLoading = true;
    private int expandedJobId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMyJobs();
    }

    private async Task LoadMyJobs()
    {
        isLoading = true;
        
        try
        {
            myJobs = await JobService.GetMyJobsAsync();
        }
        catch (Exception ex)
        {
            // Handle error
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ExpandJob(int jobId)
    {
        expandedJobId = jobId;
    }

    private void CollapseJob()
    {
        expandedJobId = 0;
    }

    private async Task ToggleJobStatus(Job job)
    {
        try
        {
            var updateRequest = new UpdateJobRequest
            {
                Title = job.Title,
                Description = job.Description,
                Company = job.Company,
                Location = job.Location,
                JobType = job.JobType,
                Category = job.Category,
                SalaryRange = job.SalaryRange,
                Requirements = job.Requirements,
                Benefits = job.Benefits,
                ExpiryDate = job.ExpiryDate,
                IsActive = !job.IsActive
            };

            var result = await JobService.UpdateJobAsync(job.Id, updateRequest);
            
            if (result.Success)
            {
                job.IsActive = !job.IsActive;
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", $"Job {(job.IsActive ? "activated" : "deactivated")} successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "An error occurred while updating the job status.");
        }
    }

    private void ViewApplications(int jobId)
    {
        Navigation.NavigateTo($"/jobs/{jobId}/applications");
    }

    private void EditJob(int jobId)
    {
        Navigation.NavigateTo($"/jobs/edit/{jobId}");
    }

    private void NavigateToCreateJob()
    {
        Navigation.NavigateTo("/jobs/create");
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/employer/dashboard");
    }

    private string GetJobStatusBadgeClass(bool isActive)
    {
        return isActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800";
    }

    private string GetJobTypeBadgeClass(string jobType)
    {
        return jobType.ToLower() switch
        {
            "full-time" => "bg-blue-100 text-blue-800",
            "part-time" => "bg-yellow-100 text-yellow-800",
            "contract" => "bg-purple-100 text-purple-800",
            "remote" => "bg-green-100 text-green-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}
