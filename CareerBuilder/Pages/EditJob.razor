@page "/jobs/edit/{JobId:int}"
@using CareerBuilder.Models
@using CareerBuilder.Services
@using CareerBuilder.Services.Interface
@inject IJobService JobService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin,Employer")]

<PageTitle>Edit Job - CareerBuilder</PageTitle>

<div class="bg-white">
    <div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page header -->
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Edit Job
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Update job posting details
                </p>
            </div>
            <div class="mt-4 flex md:mt-0 md:ml-4">
                <button @onclick="NavigateBack"
                        class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                    Back to Jobs
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-8">
                <div class="inline-flex items-center">
                    <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Loading job...
                </div>
            </div>
        }
        else if (updateJobRequest != null)
        {
            <!-- Form -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <EditForm Model="@updateJobRequest" OnValidSubmit="@HandleUpdateJob">
                        <DataAnnotationsValidator />
                        
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                                <span class="block sm:inline">@errorMessage</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
                                <span class="block sm:inline">@successMessage</span>
                            </div>
                        }

                        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                            <div class="sm:col-span-2">
                                <label for="title" class="block text-sm font-medium text-gray-700">Job Title</label>
                                <InputText @bind-Value="updateJobRequest.Title" 
                                           id="title" 
                                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.Title)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="company" class="block text-sm font-medium text-gray-700">Company Name</label>
                                <InputText @bind-Value="updateJobRequest.Company" 
                                           id="company" 
                                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.Company)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="location" class="block text-sm font-medium text-gray-700">Location</label>
                                <InputText @bind-Value="updateJobRequest.Location" 
                                           id="location" 
                                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.Location)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="jobType" class="block text-sm font-medium text-gray-700">Job Type</label>
                                <InputSelect @bind-Value="updateJobRequest.JobType" 
                                             id="jobType" 
                                             class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    <option value="">Select job type</option>
                                    <option value="Full-time">Full-time</option>
                                    <option value="Part-time">Part-time</option>
                                    <option value="Contract">Contract</option>
                                    <option value="Remote">Remote</option>
                                    <option value="Internship">Internship</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => updateJobRequest.JobType)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="category" class="block text-sm font-medium text-gray-700">Category</label>
                                <InputSelect @bind-Value="updateJobRequest.Category" 
                                             id="category" 
                                             class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    <option value="">Select category</option>
                                    <option value="technology">Technology</option>
                                    <option value="marketing">Marketing</option>
                                    <option value="sales">Sales</option>
                                    <option value="design">Design</option>
                                    <option value="finance">Finance</option>
                                    <option value="healthcare">Healthcare</option>
                                    <option value="education">Education</option>
                                    <option value="other">Other</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => updateJobRequest.Category)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="salaryRange" class="block text-sm font-medium text-gray-700">Salary Range</label>
                                <InputText @bind-Value="updateJobRequest.SalaryRange" 
                                           id="salaryRange" 
                                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.SalaryRange)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="expiryDate" class="block text-sm font-medium text-gray-700">Application Deadline</label>
                                <InputDate @bind-Value="updateJobRequest.ExpiryDate" 
                                           id="expiryDate" 
                                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.ExpiryDate)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div class="sm:col-span-2">
                                <div class="flex items-center">
                                    <input type="checkbox" 
                                           id="isActive" 
                                           @bind="updateJobRequest.IsActive"
                                           class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
                                    <label for="isActive" class="ml-2 block text-sm text-gray-900">
                                        Job is active and accepting applications
                                    </label>
                                </div>
                            </div>

                            <div class="sm:col-span-2">
                                <label for="description" class="block text-sm font-medium text-gray-700">Job Description</label>
                                <InputTextArea @bind-Value="updateJobRequest.Description" 
                                               id="description" 
                                               rows="6"
                                               class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.Description)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div class="sm:col-span-2">
                                <label for="requirements" class="block text-sm font-medium text-gray-700">Requirements</label>
                                <InputTextArea @bind-Value="updateJobRequest.Requirements" 
                                               id="requirements" 
                                               rows="4"
                                               class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.Requirements)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div class="sm:col-span-2">
                                <label for="benefits" class="block text-sm font-medium text-gray-700">Benefits</label>
                                <InputTextArea @bind-Value="updateJobRequest.Benefits" 
                                               id="benefits" 
                                               rows="3"
                                               class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                                <ValidationMessage For="@(() => updateJobRequest.Benefits)" class="text-red-600 text-sm mt-1" />
                            </div>
                        </div>

                        <div class="mt-6 flex justify-end space-x-3">
                            <button type="button" 
                                    @onclick="NavigateBack"
                                    class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                Cancel
                            </button>
                            <button type="button" 
                                    @onclick="DeleteJob"
                                    class="inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                                Delete Job
                            </button>
                            <button type="submit" 
                                    disabled="@isSaving"
                                    class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                                @if (isSaving)
                                {
                                    <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <text>Updating...</text>
                                }
                                else
                                {
                                    <text>Update Job</text>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">Job not found</h3>
                <p class="mt-1 text-sm text-gray-500">The job you're looking for doesn't exist or has been deleted.</p>
                <div class="mt-6">
                    <button @onclick="NavigateBack"
                            class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Back to Jobs
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int JobId { get; set; }
    
    private UpdateJobRequest? updateJobRequest;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadJob();
    }

    private async Task LoadJob()
    {
        isLoading = true;
        
        try
        {
            var job = await JobService.GetJobByIdAsync(JobId);
            if (job != null)
            {
                updateJobRequest = new UpdateJobRequest
                {
                    Title = job.Title,
                    Description = job.Description,
                    Company = job.Company,
                    Location = job.Location,
                    JobType = job.JobType,
                    Category = job.Category,
                    SalaryRange = job.SalaryRange,
                    Requirements = job.Requirements,
                    Benefits = job.Benefits,
                    ExpiryDate = job.ExpiryDate,
                    IsActive = job.IsActive
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading job information.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdateJob()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var result = await JobService.UpdateJobAsync(JobId, updateJobRequest!);
            
            if (result.Success)
            {
                successMessage = "Job updated successfully! Redirecting...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/jobs");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteJob()
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this job? This action cannot be undone."))
        {
            try
            {
                var result = await JobService.DeleteJobAsync(JobId);
                
                if (result.Success)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Job deleted successfully!");
                    Navigation.NavigateTo("/jobs");
                }
                else
                {
                    errorMessage = result.Message;
                }
            }
            catch (Exception ex)
            {
                errorMessage = "An error occurred while deleting the job.";
            }
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/jobs");
    }
}
