@page "/test2"

@using CareerBuilder.Models
@using CareerBuilder.Services
@using CareerBuilder.Services.Interface

@inject IAuthService AuthService
@inject IJobService JobService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@* @inject IWebHostEnvironment webHostEnvironment *@
@inject HttpClient httpClient

<PageTitle>Jobs - CareerBuilder</PageTitle>

<div class="bg-white">
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page header -->
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Upload File
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Test Page to upload a file and display its content.
                </p>
            </div>
        </div>
        <div class="bg-white shadow overflow-hidden sm:rounded-md">
             <table>
                <tr>
                    <td>                        
                        <InputFile OnChange="HandleFileSelection" multiple />
                        <button class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" @onclick="ParseFile">Parse File</button>
                    </td>
                </tr>
                <tr>
                    <td>
                        @if (parsedData.Count > 0)
                        {
                            <ul>
                                @foreach (var item in parsedData)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }

                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? file;
    private List<string> parsedData = new();

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        file = e.File;
    }

    private async Task ParseFile()
    {
        if (file == null)
        {
            return;
        }

        parsedData.Clear();

        using var stream = file.OpenReadStream();
        using var reader = new StreamReader(stream);
        string? line;
        while ((line = await reader.ReadLineAsync()) != null)
        {
            // Process each line
            parsedData.Add(line);
        }
    }
}
