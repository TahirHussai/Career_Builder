@page "/jobseeker/applications"
@using CareerBuilder.Models
@using CareerBuilder.Services
@using CareerBuilder.Services.Interface
@inject IJobService JobService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "JobSeeker")]

<PageTitle>My Applications - CareerBuilder</PageTitle>

<div class="bg-white">
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page header -->
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    My Applications
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Track the status of your job applications
                </p>
            </div>
            <div class="mt-4 flex md:mt-0 md:ml-4">
                <button @onclick="NavigateToJobs"
                        class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    Apply to More Jobs
                </button>
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="mb-6">
            <div class="sm:hidden">
                <select @onchange="OnFilterChange" class="block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                    <option value="All">All Applications</option>
                    <option value="Applied">Applied</option>
                    <option value="Reviewed">Reviewed</option>
                    <option value="Interview">Interview</option>
                    <option value="Hired">Hired</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="hidden sm:block">
                <nav class="flex space-x-8">
                    <button @onclick='() => SetFilter("All")'
                            class="@GetFilterClass("All") whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        All (@myApplications.Count)
                    </button>
                    <button @onclick='() => SetFilter("Applied")'
                            class="@GetFilterClass("Applied") whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        Applied (@myApplications.Count(a => a.Status == "Applied"))
                    </button>
                    <button @onclick='() => SetFilter("Reviewed")'
                            class="@GetFilterClass("Reviewed") whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        Reviewed (@myApplications.Count(a => a.Status == "Reviewed"))
                    </button>
                    <button @onclick='() => SetFilter("Interview")'
                            class="@GetFilterClass("Interview") whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        Interview (@myApplications.Count(a => a.Status == "Interview"))
                    </button>
                    <button @onclick='() => SetFilter("Hired")'
                            class="@GetFilterClass("Hired") whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        Hired (@myApplications.Count(a => a.Status == "Hired"))
                    </button>
                    <button @onclick='() => SetFilter("Rejected")'
                            class="@GetFilterClass("Rejected") whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        Rejected (@myApplications.Count(a => a.Status == "Rejected"))
                    </button>
                </nav>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-8">
                <div class="inline-flex items-center">
                    <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Loading applications...
                </div>
            </div>
        }
        else if (filteredApplications.Any())
        {
            <!-- Applications List -->
            <div class="bg-white shadow overflow-hidden sm:rounded-md">
                <ul class="divide-y divide-gray-200">
                    @foreach (var application in filteredApplications)
                    {
                        <li>
                            <div class="px-4 py-4 sm:px-6">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center flex-1">
                                        <div class="flex-shrink-0 h-12 w-12">
                                            <div class="h-12 w-12 rounded-full bg-indigo-500 flex items-center justify-center">
                                                <span class="text-lg font-medium text-white">
                                                    @application.Company.Substring(0, 1).ToUpper()
                                                </span>
                                            </div>
                                        </div>
                                        <div class="ml-4 flex-1">
                                            <div class="flex items-center justify-between">
                                                <div>
                                                    <p class="text-sm font-medium text-indigo-600 truncate">
                                                        @application.JobTitle
                                                    </p>
                                                    <p class="text-sm text-gray-500">@application.Company</p>
                                                    <div class="mt-2 flex items-center text-sm text-gray-500">
                                                        <svg class="flex-shrink-0 mr-1.5 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a4 4 0 118 0v4m-4 12v-6m0 0V7m0 6h6m-6 0H6" />
                                                        </svg>
                                                        Applied @application.AppliedDate.ToString("MMM dd, yyyy")
                                                    </div>
                                                </div>
                                                <div class="flex items-center space-x-4">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetStatusBadgeClass(application.Status)">
                                                        @application.Status
                                                    </span>
                                                    <button @onclick="() => ViewApplicationDetails(application)"
                                                            class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                        View Details
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Application Timeline -->
                                @if (expandedApplicationId == application.Id)
                                {
                                    <div class="mt-4 border-t border-gray-200 pt-4">
                                        <h4 class="text-sm font-medium text-gray-900 mb-3">Application Timeline</h4>
                                        <div class="flow-root">
                                            <ul class="-mb-8">
                                                <li>
                                                    <div class="relative pb-8">
                                                        <div class="relative flex space-x-3">
                                                            <div>
                                                                <span class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center ring-8 ring-white">
                                                                    <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                                    </svg>
                                                                </span>
                                                            </div>
                                                            <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                                                                <div>
                                                                    <p class="text-sm text-gray-500">Application submitted</p>
                                                                </div>
                                                                <div class="text-right text-sm whitespace-nowrap text-gray-500">
                                                                    @application.AppliedDate.ToString("MMM dd, yyyy")
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                                
                                                @if (application.Status != "Applied")
                                                {
                                                    <li>
                                                        <div class="relative pb-8">
                                                            <div class="relative flex space-x-3">
                                                                <div>
                                                                    <span class="h-8 w-8 rounded-full @GetTimelineIconClass(application.Status) flex items-center justify-center ring-8 ring-white">
                                                                        @if (application.Status == "Hired")
                                                                        {
                                                                            <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                                            </svg>
                                                                        }
                                                                        else if (application.Status == "Rejected")
                                                                        {
                                                                            <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                                                            </svg>
                                                                        }
                                                                        else
                                                                        {
                                                                            <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                                            </svg>
                                                                        }
                                                                    </span>
                                                                </div>
                                                                <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                                                                    <div>
                                                                        <p class="text-sm text-gray-500">Status updated to @application.Status</p>
                                                                    </div>
                                                                    <div class="text-right text-sm whitespace-nowrap text-gray-500">
                                                                        @DateTime.Now.AddDays(-1).ToString("MMM dd, yyyy")
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        
                                        <!-- Cover Letter -->
                                        <div class="mt-4">
                                            <h5 class="text-sm font-medium text-gray-900">Your Cover Letter</h5>
                                            <div class="mt-2 p-3 bg-gray-50 rounded-md">
                                                <p class="text-sm text-gray-700 whitespace-pre-wrap">@application.CoverLetter</p>
                                            </div>
                                        </div>
                                        
                                        <div class="mt-4 flex justify-end">
                                            <button @onclick="() => CollapseApplication()"
                                                    class="text-sm text-indigo-600 hover:text-indigo-500">
                                                Hide Details
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No applications found</h3>
                <p class="mt-1 text-sm text-gray-500">
                    @if (currentFilter == "All")
                    {
                        <text>You haven't applied to any jobs yet.</text>
                    }
                    else
                    {
                        <text>No applications with status "@currentFilter".</text>
                    }
                </p>
                <div class="mt-6">
                    <button @onclick="NavigateToJobs"
                            class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Browse Jobs
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<JobApplication> myApplications = new();
    private List<JobApplication> filteredApplications = new();
    private bool isLoading = true;
    private string currentFilter = "All";
    private int expandedApplicationId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMyApplications();
    }

    private async Task LoadMyApplications()
    {
        isLoading = true;
        
        try
        {
            myApplications = await JobService.GetMyApplicationsAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            // Handle error
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        currentFilter = filter;
        ApplyFilter();
    }

    private void OnFilterChange(ChangeEventArgs e)
    {
        currentFilter = e.Value?.ToString() ?? "All";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (currentFilter == "All")
        {
            filteredApplications = myApplications;
        }
        else
        {
            filteredApplications = myApplications.Where(a => a.Status == currentFilter).ToList();
        }
    }

    private void ViewApplicationDetails(JobApplication application)
    {
        expandedApplicationId = expandedApplicationId == application.Id ? 0 : application.Id;
    }

    private void CollapseApplication()
    {
        expandedApplicationId = 0;
    }

    private void NavigateToJobs()
    {
        Navigation.NavigateTo("/jobs");
    }

    private string GetFilterClass(string filter)
    {
        return currentFilter == filter 
            ? "border-indigo-500 text-indigo-600" 
            : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Applied" => "bg-blue-100 text-blue-800",
            "Reviewed" => "bg-yellow-100 text-yellow-800",
            "Interview" => "bg-purple-100 text-purple-800",
            "Rejected" => "bg-red-100 text-red-800",
            "Hired" => "bg-green-100 text-green-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetTimelineIconClass(string status)
    {
        return status switch
        {
            "Reviewed" => "bg-yellow-500",
            "Interview" => "bg-purple-500",
            "Rejected" => "bg-red-500",
            "Hired" => "bg-green-500",
            _ => "bg-blue-500"
        };
    }
}
