@using CareerBuilder.Models
@using CareerBuilder.Services
@using CareerBuilder.Services.Interface
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@implements IDisposable

<nav class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex">
                <div class="flex-shrink-0 flex items-center">
                    <NavLink href="/" class="text-xl font-bold text-indigo-600">
                        CareerBuilder
                    </NavLink>
                </div>
                <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                    <NavLink href="/"
                             class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium"
                             ActiveClass="border-indigo-500 text-gray-900"
                             Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                    <NavLink href="/jobs"
                             class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium"
                             ActiveClass="border-indigo-500 text-gray-900">
                        Jobs
                    </NavLink>
                    <AuthorizeView Roles="JobSeeker">
                        <Authorized>
                            <NavLink href="/jobseeker/dashboard"
                                     class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium"
                                     ActiveClass="border-indigo-500 text-gray-900">
                                Dashboard
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Employer">
                        <Authorized>
                            <NavLink href="/employer/dashboard"
                                     class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium"
                                     ActiveClass="border-indigo-500 text-gray-900">
                                Dashboard
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <NavLink href="/admin"
                                     class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium"
                                     ActiveClass="border-indigo-500 text-gray-900">
                                Admin
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
            <div class="hidden sm:ml-6 sm:flex sm:items-center">
                @if (isAuthenticated && currentUser != null)
                {
                    <div class="ml-3 relative">
                        <div class="flex items-center space-x-4">
                            <span class="text-gray-700 text-sm">
                                Welcome, @currentUser.FirstName!
                            </span>
                            <button @onclick="HandleLogout"
                                    class="bg-white text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                <span class="sr-only">Logout</span>
                                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center space-x-4">
                        <NavLink href="/login"
                                 class="text-gray-500 hover:text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
                            Sign In
                        </NavLink>
                        <NavLink href="/register"
                                 class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-md text-sm font-medium">
                            Sign Up
                        </NavLink>
                    </div>
                }
            </div>
            <div class="-mr-2 flex items-center sm:hidden">
                <button @onclick="ToggleMobileMenu"
                        class="bg-white inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500">
                    <span class="sr-only">Open main menu</span>
                    <svg class="@(showMobileMenu ? "hidden" : "block") h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg class="@(showMobileMenu ? "block" : "hidden") h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    @if (showMobileMenu)
    {
        <div class="sm:hidden">
            <div class="pt-2 pb-3 space-y-1">
                <NavLink href="/"
                         class="border-transparent text-gray-600 hover:bg-gray-50 hover:border-gray-300 hover:text-gray-800 block pl-3 pr-4 py-2 border-l-4 text-base font-medium"
                         ActiveClass="bg-indigo-50 border-indigo-500 text-indigo-700"
                         Match="NavLinkMatch.All">
                    Home
                </NavLink>
                <NavLink href="/jobs"
                         class="border-transparent text-gray-600 hover:bg-gray-50 hover:border-gray-300 hover:text-gray-800 block pl-3 pr-4 py-2 border-l-4 text-base font-medium"
                         ActiveClass="bg-indigo-50 border-indigo-500 text-indigo-700">
                    Jobs
                </NavLink>
                @if (isAuthenticated && currentUser?.Roles.Contains("JobSeeker") == true)
                {
                    <NavLink href="/jobseeker/dashboard"
                             class="border-transparent text-gray-600 hover:bg-gray-50 hover:border-gray-300 hover:text-gray-800 block pl-3 pr-4 py-2 border-l-4 text-base font-medium"
                             ActiveClass="bg-indigo-50 border-indigo-500 text-indigo-700">
                        Dashboard
                    </NavLink>
                }
                @if (isAuthenticated && currentUser?.Roles.Contains("Employer") == true)
                {
                    <NavLink href="/employer/dashboard"
                             class="border-transparent text-gray-600 hover:bg-gray-50 hover:border-gray-300 hover:text-gray-800 block pl-3 pr-4 py-2 border-l-4 text-base font-medium"
                             ActiveClass="bg-indigo-50 border-indigo-500 text-indigo-700">
                        Dashboard
                    </NavLink>
                }
                @if (isAuthenticated && currentUser?.Roles.Contains("Admin") == true)
                {
                    <NavLink href="/admin"
                             class="border-transparent text-gray-600 hover:bg-gray-50 hover:border-gray-300 hover:text-gray-800 block pl-3 pr-4 py-2 border-l-4 text-base font-medium"
                             ActiveClass="bg-indigo-50 border-indigo-500 text-indigo-700">
                        Admin
                    </NavLink>
                }
            </div>
            <div class="pt-4 pb-3 border-t border-gray-200">
                @if (isAuthenticated && currentUser != null)
                {
                    <div class="flex items-center px-4">
                        <div class="ml-3">
                            <div class="text-base font-medium text-gray-800">@currentUser.FirstName @currentUser.LastName</div>
                            <div class="text-sm font-medium text-gray-500">@currentUser.Email</div>
                        </div>
                    </div>
                    <div class="mt-3 space-y-1">
                        <button @onclick="HandleLogout"
                                class="block px-4 py-2 text-base font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-100 w-full text-left">
                            Sign out
                        </button>
                    </div>
                }
                else
                {
                    <div class="mt-3 space-y-1">
                        <NavLink href="/login"
                                 class="block px-4 py-2 text-base font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-100">
                            Sign In
                        </NavLink>
                        <NavLink href="/register"
                                 class="block px-4 py-2 text-base font-medium text-gray-500 hover:text-gray-800 hover:bg-gray-100">
                            Sign Up
                        </NavLink>
                    </div>
                }
            </div>
        </div>
    }
</nav>

@code {
    private bool showMobileMenu = false;
    private bool isAuthenticated = false;
    private UserInfo? currentUser = null;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to authentication state changes
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await CheckAuthenticationStatus();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await CheckAuthenticationStatus();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckAuthenticationStatus()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

            if (isAuthenticated)
            {
                currentUser = await AuthService.GetCurrentUserAsync();
            }
            else
            {
                currentUser = null;
            }
        }
        catch (Exception ex)
        {
            // Log error if needed
            isAuthenticated = false;
            currentUser = null;
        }
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/");
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
